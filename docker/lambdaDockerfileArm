ARG FUNCTION_DIR="/function"

FROM public.ecr.aws/lambda/python:3.12-arm64

ARG SOURCE
ARG DIST_PATH

# Amazon Linux 2023 uses dnf, not yum
RUN dnf -qy install gcc gcc-c++ make && dnf clean all

# Install tig from artifactory
COPY $DIST_PATH $DIST_PATH

# Install Lambda Runtime Interface
RUN pip3 install awslambdaric --target $LAMBDA_TASK_ROOT

# Install your package
RUN pip3 install --no-cache-dir --force \
    --index-url https://pypi.org/simple/ \
    --extra-index-url https://test.pypi.org/simple/ \
    --target "${LAMBDA_TASK_ROOT}" ${SOURCE}

RUN rm -rf $DIST_PATH

ENTRYPOINT []
CMD ["podaac.lambda_handler.lambda_handler.handler"]
